page,
.page-container {
  min-height: 100vh;
  background: #fff;
}

.custom-nav {
  position: fixed;
  top: env(safe-area-inset-top);
  left: 0;
  right: 0;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.98);
  z-index: 20;
  box-shadow: 0 1rpx 0 rgba(15, 23, 42, 0.06);
}

.nav-row {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.back-icon,
.nav-holder {
  width: 48rpx;
}

.back-icon {
  font-size: 44rpx;
  color: #111827;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.content-area {
  height: 100vh;
  padding: calc(env(safe-area-inset-top) + 108rpx) 30rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.doc-title {
  display: block;
  text-align: center;
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #ff6b6b;
  margin-bottom: 28rpx;
}

.doc-section {
  margin-bottom: 26rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #111827;
  margin-bottom: 12rpx;
}

.section-line {
  display: block;
  font-size: 26rpx;
  line-height: 1.72;
  color: #374151;
  margin-bottom: 6rpx;
}
