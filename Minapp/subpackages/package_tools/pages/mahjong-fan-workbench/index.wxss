page {
  --primary: #667eea;
  --primary-deep: #5b6ee1;
  --teal: #4fd1c5;
  --danger: #ff4d5b;
  --success: #34c759;
}

page,
.page-shell {
  min-height: 100vh;
  background: radial-gradient(circle at 50% 0%, rgba(227, 187, 147, 0.78) 0%, rgba(194, 147, 112, 0.88) 34%, #9f7a5f 100%);
}

.custom-nav {
  position: fixed;
  top: env(safe-area-inset-top);
  left: 0;
  right: 0;
  height: 88rpx;
  z-index: 20;
}

.nav-row {
  height: 100%;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-icon,
.nav-placeholder {
  width: 48rpx;
  color: #fff;
}

.back-icon {
  font-size: 44rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.workbench-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 104rpx) 18rpx calc(28rpx + env(safe-area-inset-bottom));
}

.hero-board {
  text-align: center;
  color: #fff;
  padding: 12rpx 90rpx 28rpx;
}

.hero-caption {
  display: block;
  font-size: 30rpx;
  line-height: 1.3;
}

.hero-total {
  display: block;
  font-size: 88rpx;
  line-height: 1.05;
  font-weight: 700;
  margin-top: 10rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
}

.hero-subrow {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.hero-round-label,
.hero-round-score {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.95);
}

.hero-round-score {
  font-size: 48rpx;
  font-weight: 700;
}

.hero-mini-btn {
  min-width: 88rpx;
  height: 54rpx;
  border-radius: 18rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-mini-btn.save {
  background: #48c774;
  color: #fff;
}

.hero-mini-btn.more {
  background: rgba(255,255,255,0.22);
  color: #fff;
  border: 1rpx solid rgba(255,255,255,0.3);
}

.hero-summary {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.8);
}

.board-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.score-card {
  min-height: 300rpx;
  padding: 18rpx 16rpx 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 20rpx 40rpx rgba(55, 34, 17, 0.12);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.header-badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-badge.income {
  background: #ff574d;
}

.header-badge.outcome {
  background: #34c759;
}

.header-score {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
}

.module-block,
.player-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 22rpx;
  padding: 14rpx;
}

.module-block + .module-block,
.player-card + .player-card {
  margin-top: 14rpx;
}

.module-head,
.player-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.module-head.inner.second {
  margin-top: 12rpx;
}

.module-title,
.player-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #475569;
}

.module-score,
.player-score {
  font-size: 24rpx;
  color: #475569;
}

.counter-row {
  display: grid;
  grid-template-columns: 1fr auto auto;
  align-items: center;
  gap: 10rpx;
  min-height: 64rpx;
}

.counter-row.compact {
  min-height: 54rpx;
}

.counter-name,
.counter-meta {
  font-size: 22rpx;
  color: #64748b;
}

.counter-box {
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.counter-btn,
.counter-value {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #334155;
}

.counter-btn {
  background: #e5e7eb;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.rule-chip {
  min-height: 42rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid #dbe3ec;
  background: #fff;
  color: #4b5563;
  font-size: 21rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.rule-chip-active {
  border-color: rgba(102,126,234,0.55);
  background: rgba(102,126,234,0.12);
  color: #4453b8;
}

.rule-value {
  color: #7c8699;
  font-size: 20rpx;
}

.family-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.family-chip {
  min-width: 64rpx;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
  background: #fff;
  color: #64748b;
  font-size: 21rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.family-chip-active {
  background: #ff6b6b;
  color: #fff;
  border-color: #ff6b6b;
}

.floating-tools {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 180rpx);
  z-index: 18;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.left-tools {
  left: 14rpx;
}

.right-tools {
  right: 14rpx;
}

.float-btn {
  width: 74rpx;
  min-height: 120rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.18);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  backdrop-filter: blur(10rpx);
}

.float-btn.danger {
  color: #ffeded;
}

.float-ico {
  font-size: 28rpx;
}

.float-text {
  width: 24rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(35, 27, 23, 0.42);
  z-index: 45;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
}

.config-dialog {
  width: 100%;
  max-width: 680rpx;
  max-height: 84vh;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 28rpx;
  box-shadow: 0 28rpx 56rpx rgba(35, 27, 23, 0.18);
  overflow: hidden;
}

.dialog-head {
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.7);
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2b2f38;
}

.dialog-close {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: #9ca3af;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.config-scroll {
  max-height: calc(84vh - 184rpx);
}

.config-top-card {
  padding: 12rpx 0;
  background: linear-gradient(180deg, #f3f7ff 0%, #ffffff 100%);
}

.config-list {
  padding-bottom: 8rpx;
}

.config-row {
  min-height: 72rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf1f6;
}

.top-row {
  border-bottom: none;
}

.top-row.plain {
  padding-bottom: 6rpx;
}

.config-name {
  font-size: 28rpx;
  color: #4b5563;
}

.config-name.active {
  color: #3478f6;
  font-weight: 700;
}

.config-value-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.config-value {
  font-size: 28rpx;
  color: #2f3542;
}

.config-arrow {
  font-size: 18rpx;
  color: #9ca3af;
}

.hard-cap-box {
  min-width: 190rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #edf1f6;
  font-size: 28rpx;
  color: #2f3542;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-rule-box {
  height: 72rpx;
  margin: 16rpx 24rpx 10rpx;
  border-radius: 16rpx;
  border: 1rpx dashed #d9dde7;
  color: #ff4d5b;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rule-tip,
.template-tip {
  display: block;
  padding: 0 24rpx 8rpx;
  font-size: 21rpx;
  color: #9ca3af;
}

.dialog-actions {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(22rpx + env(safe-area-inset-bottom));
}

.dialog-btn {
  flex: 1;
  height: 74rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.dialog-btn.ghost {
  background: #f3f4f6;
  color: #5b6474;
}

.dialog-btn.success {
  background: #34c759;
  color: #fff;
}

.dialog-btn.danger {
  background: #ff4d5b;
  color: #fff;
}

.picker-overlay {
  align-items: flex-end;
  padding: 0;
}

.picker-sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.picker-title {
  display: block;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #6b7280;
  margin-bottom: 20rpx;
}

.picker-list {
  max-height: 44vh;
}

.picker-option {
  min-height: 76rpx;
  border-bottom: 1rpx solid #eef2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #a0a7b4;
}

.picker-option-active {
  color: #2b2f38;
  font-weight: 700;
}

.picker-actions {
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 0;
  margin-top: 16rpx;
}
